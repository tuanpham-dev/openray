    }
  ],
  "preferences": [
    {
      "name": "apiToken",
      "type": "password",
      "title": "API Token",
      "required": true
    },
    {
      "name": "showDetails",
      "type": "checkbox",
      "label": "Show details",
      "default": true
    }
  ]
}
