{
  "name": "demo-extension",
  "title": "Demo Extension",
  "description": "A fixture extension manifest",
  "icon": "icon.png",
  "author": "example",
  "categories": ["Productivity"],
  "commands": [
    {
      "name": "search",
      "title": "Search Demo",
      "subtitle": "Demo",
      "mode": "view",
      "keywords": ["demo", "search"]
    },
    {
      "name": "quick-action",
      "title": "Quick Action",
