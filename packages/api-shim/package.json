    "react-reconciler": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-reconciler": "^0.33.0",
    "@openray/protocol": "workspace:*",
    "esbuild": "^0.27.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
